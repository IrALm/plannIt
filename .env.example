# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Sentry (M8) — NEXT_PUBLIC_SENTRY_DSN suffit pour activer le reporting runtime.
# SENTRY_ORG/SENTRY_PROJECT/SENTRY_AUTH_TOKEN ne servent qu'à l'upload des
# source maps au build ; absents, le build réussit quand même (juste sans
# source maps lisibles côté Sentry).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Site (M6/M7) — origine publique du déploiement, sert de fallback si les
# headers de la requête ne suffisent pas à reconstruire les redirect URLs Auth.
NEXT_PUBLIC_SITE_URL=
